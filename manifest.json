{
    "manifest_version": 3,
    "name": "VaultBix - Real-Time Data Leak Guard",
    "version": "5.2.4",
    "description": "Detects and blocks API keys, secrets, credentials, and PII before they leave your browser. 100% local — nothing sent to any server.",
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "VaultBix - Data Leak Guard"
    },
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://m365.cloud.microsoft/*",
        "https://github.com/copilot/*",
        "https://github.com/*/copilot/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok/*",
        "https://poe.com/*",
        "https://huggingface.co/chat/*",
        "https://chat.mistral.ai/*",
        "https://you.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://*.chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://claude.ai/*",
                "https://*.claude.ai/*",
                "https://gemini.google.com/*",
                "https://aistudio.google.com/*",
                "https://copilot.microsoft.com/*",
                "https://m365.cloud.microsoft/*",
                "https://github.com/copilot/*",
                "https://github.com/*/copilot/*",
                "https://www.perplexity.ai/*",
                "https://chat.deepseek.com/*",
                "https://grok.com/*",
                "https://x.com/i/grok/*",
                "https://poe.com/*",
                "https://huggingface.co/chat/*",
                "https://chat.mistral.ai/*",
                "https://you.com/*"
            ],
            "js": [
                "content/inject.js"
            ],
            "run_at": "document_start",
            "all_frames": false,
            "world": "MAIN"
        },
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://*.chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://claude.ai/*",
                "https://*.claude.ai/*",
                "https://gemini.google.com/*",
                "https://aistudio.google.com/*",
                "https://copilot.microsoft.com/*",
                "https://m365.cloud.microsoft/*",
                "https://github.com/copilot/*",
                "https://github.com/*/copilot/*",
                "https://www.perplexity.ai/*",
                "https://chat.deepseek.com/*",
                "https://grok.com/*",
                "https://x.com/i/grok/*",
                "https://poe.com/*",
                "https://huggingface.co/chat/*",
                "https://chat.mistral.ai/*",
                "https://you.com/*"
            ],
            "js": [
                "content/main.js"
            ],
            "run_at": "document_start",
            "all_frames": false
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}