{
    "manifest_version": 3,
    "name": "VaultBix - AI Data Leak Guard",
    "version": "4.0.0",
    "description": "Detects API keys, passwords, and sensitive data before you share them with AI tools. 100% local scanning — nothing leaves your browser.",

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_popup": "popup.html",
        "default_title": "VaultBix - AI Data Leak Guard"
    },

    "permissions": [
        "storage",
        "alarms"
    ],

    "host_permissions": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.bing.com/chat/*",
        "https://www.bing.com/search*",
        "https://github.com/*",
        "https://poe.com/*",
        "https://you.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.x.ai/*",
        "https://huggingface.co/chat/*",
        "https://chat.mistral.ai/*",
        "https://labs.google/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "https://chat.openai.com/*",
                "https://chatgpt.com/*",
                "https://claude.ai/*",
                "https://gemini.google.com/*",
                "https://copilot.microsoft.com/*",
                "https://www.bing.com/chat/*",
                "https://www.bing.com/search*",
                "https://github.com/*",
                "https://poe.com/*",
                "https://you.com/*",
                "https://www.perplexity.ai/*",
                "https://perplexity.ai/*",
                "https://chat.deepseek.com/*",
                "https://grok.x.ai/*",
                "https://huggingface.co/chat/*",
                "https://chat.mistral.ai/*",
                "https://labs.google/*"
            ],
            "js": ["content/main.js"],
            "type": "module",
            "run_at": "document_idle",
            "all_frames": false
        }
    ],

    "web_accessible_resources": [
        {
            "resources": [
                "dashboard.html",
                "dashboard.js",
                "style.css",
                "content/detection/detector.js",
                "content/detection/patterns.js",
                "content/detection/ml-detector.js",
                "content/detection/ml-worker.js"
            ],
            "matches": ["<all_urls>"]
        }
    ],

    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
